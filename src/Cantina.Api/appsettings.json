{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Database": {
    "Provider": "Sqlite",
    "ApplyMigrations": false
  },
  "Security": {
    "HttpsRedirection": true
  },
  "Authentication": {
    "RateLimit": {
      "PermitLimit": 10
    }
  },
  "Catalogue": {
    "RateLimit": {
      "PermitLimit": 100
    }
  }
}
